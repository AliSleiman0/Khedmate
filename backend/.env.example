# ── Droplet IP ────────────────────────────────────────────────────────────
# (Update to a domain name later when you attach one)
DROPLET_IP=157.230.22.154
DOMAIN=api.khudmati.app

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_DB=khudmati
POSTGRES_USER=khudmati_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PG_PASSWORD

# ── JWT ───────────────────────────────────────────────────────────────────
# Must be ≥32 characters. Generate with: openssl rand -base64 48
JWT_KEY=CHANGE_ME_AT_LEAST_32_CHAR_RANDOM_SECRET_KEY

# ── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY
# Get from: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET

# ── Firebase Cloud Messaging ──────────────────────────────────────────────
# Paste the entire service account JSON as a single line (escape newlines).
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"REPLACE",...}

# ── Platform defaults ─────────────────────────────────────────────────────
COMMISSION_RATE=0.15
JOB_TIMEOUT_MINUTES=2
# ── SMTP2GO (email OTP delivery) ───────────────────────────────
SMTP2GO_API_KEY=api-REPLACE_WITH_YOUR_KEY
# ── Demo / testing ───────────────────────────────────────────────────────
# Set to true to skip Stripe and mark jobs Paid immediately on completion.
# Never use in production.
PAYMENT_BYPASS=false
